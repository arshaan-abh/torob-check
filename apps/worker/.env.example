# Local worker connection. Docker Compose overrides this with the internal Postgres host.
DATABASE_URL=postgresql://torob:torob_dev@localhost:5432/torob
# Must match SETTINGS_ENCRYPTION_KEY used by the web app to read encrypted provider keys.
SETTINGS_ENCRYPTION_KEY=
# Optional fallback. A Tavily key stored in /admin/settings takes precedence.
TAVILY_API_KEY=
INSTAGRAM_API_VERSION=v26.0
