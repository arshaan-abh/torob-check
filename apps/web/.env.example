# Server-only PostgreSQL connection string. Keep this out of NEXT_PUBLIC_* variables.
DATABASE_URL=postgresql://torob:torob_dev@localhost:5432/torob

# Required for verified account sign-in and encrypted settings.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
SYSTEM_ADMIN_EMAILS=
# Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# Optional bootstrap values. Values saved in /admin/settings are encrypted in PostgreSQL
# and take precedence over these environment values.
AI_PROVIDER=gateway
AI_MODEL=
AI_GATEWAY_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
TAVILY_API_KEY=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=v26.0
SMTP_URL=
SMTP_FROM=
