# Served to the map at runtime by /api/runtime-config. This browser key is public;
# restrict it to your app's allowed origins in Neshan's dashboard.
NESHAN_API_KEY=

# Server-only PostgreSQL connection string. Keep this out of NEXT_PUBLIC_* variables.
DATABASE_URL=postgresql://torob:torob_dev@localhost:5432/torob

# Optional OpenAI-compatible model endpoint. Keep the API key server-only.
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_MODEL=
